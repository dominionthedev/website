    margin-top: var(--space-4);
  }

  .philosophy-line {
    font-size: var(--text-header);
    line-height: 1.4;
    min-height: 1.4em;
  }

  .philosophy-line::before {
    content: "> ";
    color: var(--c-green);
  }

  .philosophy-proof {
    font-size: var(--text-terminal);
    color: var(--c-mute);
    line-height: var(--leading-terminal);
    padding-left: calc(var(--space-2) + 1ch);
    border-left: 1px solid var(--c-ghost);
    margin-top: var(--space-2);
  }
</style>
