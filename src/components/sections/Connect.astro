<section class="stage-section" data-stage="connect" data-title="Connect" data-align="center">
  <p class="label">Connect</p>
  <h2>How to reach me.</h2>
  <div class="connect-list">
    <a
      href="https://github.com/dominionthedev"
      target="_blank"
      rel="noopener noreferrer"
      class="connect-line link-underline"
      data-typed
      data-typed-text="github.com/dominionthedev"
    ></a>
    <a
      href="mailto:dominionthedeveloper@gmail.com"
      class="connect-line link-underline"
      data-typed
      data-typed-text="dominionthedeveloper@gmail.com"
    ></a>
    <a
      href="https://twitter.com/dominionthedev"
      target="_blank"
      rel="noopener noreferrer"
      class="connect-line link-underline"
      data-typed
      data-typed-text="x.com/dominionthedev"
    ></a>
  </div>
</section>

<style>
  .connect-list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .connect-line {
    font-size: var(--text-header);
    min-height: 1.3em;
    display: block;
  }

  .connect-line::before {
    content: "> ";
    color: var(--c-green);
  }
</style>
